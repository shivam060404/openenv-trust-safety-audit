   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# CELL 1 — INSTALL UNSLOTH (correct Kaggle command)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# The Kaggle-specific install for Unsloth:\n",
    "import subprocess\n",
    "subprocess.run([\n",
    "    'pip', 'install', '--no-deps', 'bitsandbytes', 'accelerate', 'xformers==0.0.29.post3',\n",
    "    'peft', 'trl==0.15.2', 'triton',\n",
    "    'cut_cross_entropy', 'unsloth_zoo'\n",
    "], check=False, capture_output=True)\n",
    "\n",
    "subprocess.run([\n",
    "    'pip', 'install', 'unsloth[colab-new]'\n",
    "], check=False, capture_output=True)\n",
    "\n",
    "# Alternative fallback if above fails:\n",
    "# pip install unsloth\n",
    "subprocess.run(['pip', 'install', '-q', 'unsloth'], check=False, capture_output=True)\n",
    "\n",
    "subprocess.run(['pip', 'install', '-q', 'wandb', 'datasets', 'huggingface_hub'], \n",
    "               check=False, capture_output=True)\n",
    "\n",
    "print('✅ Packages installed')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
