    "# CELL 9 — GENERATE REWARD CURVE PLOT (for pitch slide)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
