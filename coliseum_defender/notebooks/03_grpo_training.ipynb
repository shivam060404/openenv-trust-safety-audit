    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# CELL 3 — LOAD SFT MODEL\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "from huggingface_hub import login\n",
    "if HF_TOKEN:\n",
    "    login(token=HF_TOKEN)\n",
    "\n",
    "# Try loading from HF Hub (SFT checkpoint)\n",
    "# Falls back to unsloth base model if SFT checkpoint not available yet\n",
    "try:\n",
    "    model, tokenizer = FastLanguageModel.from_pretrained(\n",
    "        model_name      = SFT_MODEL_REPO,\n",
    "        max_seq_length  = MAX_SEQ_LENGTH,\n",
    "        dtype           = None,\n",
    "        load_in_4bit    = True,\n",
    "        token           = HF_TOKEN if HF_TOKEN else None,\n",
    "    )\n",
    "    print(f'✅ Loaded SFT checkpoint: {SFT_MODEL_REPO}')\n",
    "except Exception as e:\n",
    "    print(f'⚠️  SFT checkpoint not found ({e}), loading base model...')\n",
    "    model, tokenizer = FastLanguageModel.from_pretrained(\n",
    "        model_name      = 'unsloth/Qwen2.5-1.5B-Instruct-bnb-4bit',\n",
    "        max_seq_length  = MAX_SEQ_LENGTH,\n",
    "        dtype           = None,\n",
    "        load_in_4bit    = True,\n",
    "        token           = HF_TOKEN if HF_TOKEN else None,\n",
    "    )\n",
    "    print('⚠️  Using base model for GRPO (SFT step missing)')\n",
    "\n",
    "# Apply LoRA for GRPO\n",
    "model = FastLanguageModel.get_peft_model(\n",
    "    model,\n",
    "    r                          = LORA_RANK,\n",
    "    target_modules             = ['q_proj', 'k_proj', 'v_proj', 'o_proj',\n",
    "                                  'gate_proj', 'up_proj', 'down_proj'],\n",
    "    lora_alpha                 = LORA_ALPHA,\n",
    "    lora_dropout               = 0.0,    # 0 dropout for GRPO (standard practice)\n",
    "    bias                       = 'none',\n",
    "    use_gradient_checkpointing = 'unsloth',\n",
    "    random_state               = SEED,\n",
    "    use_rslora                 = True,\n",
    ")\n",
    "\n",
    "print(f'✅ Model ready for GRPO training')"
   ]
