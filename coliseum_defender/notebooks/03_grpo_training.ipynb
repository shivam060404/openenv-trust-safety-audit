    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# CELL 7 — RUN GRPO TRAINING\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "from trl import GRPOTrainer, GRPOConfig\n",
    "\n",
    "grpo_config = GRPOConfig(\n",
    "    # Core GRPO params\n",
    "    num_generations          = GRPO_N_GENERATIONS,  # G=8 completions per prompt\n",
    "    max_new_tokens           = 80,                  # Defender output is short\n",
    "    temperature              = 0.7,                 # Some diversity for group comparison\n",
    "    \n",
    "    # Training\n",
    "    max_steps                = GRPO_MAX_STEPS,\n",
    "    per_device_train_batch_size = GRPO_BATCH_SIZE,\n",
    "    gradient_accumulation_steps = 4,\n",
    "    learning_rate            = GRPO_LR,\n",
    "    lr_scheduler_type        = 'cosine',\n",
    "    warmup_steps             = 20,\n",
    "    weight_decay             = 0.01,\n",
    "    \n",
    "    # Precision\n",
    "    fp16                     = not torch.cuda.is_bf16_supported(),\n",
    "    bf16                     = torch.cuda.is_bf16_supported(),\n",
    "    \n",
    "    # GRPO-specific\n",
    "    use_vllm                 = False,  # No vLLM on Kaggle (use Unsloth inference)\n",
    "    \n",
    "    # Logging & saving\n",
    "    output_dir               = str(OUTPUT_DIR),\n",
    "    logging_steps            = 5,\n",
    "    save_steps               = 100,\n",
    "    save_total_limit         = 2,\n",
    "    report_to                = report_to,\n",
    "    seed                     = SEED,\n",
    ")\n",
    "\n",
    "trainer = GRPOTrainer(\n",
    "    model         = model,\n",
    "    tokenizer     = tokenizer,\n",
    "    args          = grpo_config,\n",
