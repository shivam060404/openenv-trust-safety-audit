    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# CELL 2 — CONFIG\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "# ── Auth ──\n",
    "HF_TOKEN      = os.environ.get('HF_TOKEN', '')\n",
    "WANDB_API_KEY = os.environ.get('WANDB_API_KEY', '')\n",
    "HF_USERNAME   = 'adityajethani11'  # YOUR HF username\n",
    "\n",
    "# ── Environment server (from Shivam) ──\n",
    "# SET THIS to Shivam's server URL on hackathon day\n",
    "# Options:\n",
    "# 1. If Shivam is running locally on same machine: 'http://localhost:7860'\n",
    "# 2. If Shivam deploys to HF Space: 'https://xxxxx.hf.space'\n",
    "# 3. If ngrok tunnel: 'https://xxxxx.ngrok.io'\n",
    "ENV_SERVER_URL = os.environ.get('ENV_SERVER_URL', 'http://localhost:7860')\n",
    "\n",
    "# ── MOCK MODE: set to True if server isn't ready yet ──\n",
    "# Mock rewards allow GRPO training without the live environment.\n",
    "# Switch to False once Shivam's server is up.\n",
    "MOCK_ENV = False\n",
    "\n",
    "# ── Model ──\n",
    "SFT_MODEL_REPO  = f'{HF_USERNAME}/coliseum-defender-sft'   # input\n",
    "GRPO_MODEL_REPO = f'{HF_USERNAME}/coliseum-defender-grpo'  # output\n",
    "\n",
    "# ── GRPO Hyperparameters ──\n",
    "MAX_SEQ_LENGTH    = 512\n",
    "LORA_RANK         = 32\n",
    "LORA_ALPHA        = 64\n",
    "GRPO_BATCH_SIZE   = 2    # Smaller batch for GRPO (generates G completions per sample)\n",
    "GRPO_N_GENERATIONS = 8   # G: number of completions per prompt. G=8 is standard GRPO.\n",
    "GRPO_MAX_STEPS    = 500  # Target: 500 steps ≈ 90 min on T4\n",
    "GRPO_LR           = 5e-5 # Lower than SFT LR\n",
    "SEED              = 42\n",
    "\n",
    "WORK_DIR   = Path('/kaggle/working')\n",
    "OUTPUT_DIR = WORK_DIR / 'grpo_output'\n",
    "OUTPUT_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "print('📋 GRPO Config:')\n",
    "print(f'   SFT base:     {SFT_MODEL_REPO}')\n",
    "print(f'   Env server:   {ENV_SERVER_URL}')\n",
    "print(f'   Mock env:     {MOCK_ENV}')\n",
    "print(f'   Steps:        {GRPO_MAX_STEPS}')\n",
    "print(f'   Generations:  {GRPO_N_GENERATIONS}')"
   ]
